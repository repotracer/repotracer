    "rust"
  ],
  "license": "MIT",
  "homepage": "https://github.com/repotracer/repotracer#readme",
  "bugs": {
    "url": "https://github.com/repotracer/repotracer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repotracer/repotracer.git",
    "directory": "packages/npm"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
