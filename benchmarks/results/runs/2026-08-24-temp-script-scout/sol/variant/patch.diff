+
+    struct MixedSpeed {
+        started: Arc<AtomicUsize>,
+        canceled: Arc<AtomicUsize>,
+    }
+
+    struct CancelGuard {
+        canceled: Arc<AtomicUsize>,
+        completed: bool,
+    }
+
+    impl Drop for CancelGuard {
+        fn drop(&mut self) {
+            if !self.completed {
+                self.canceled.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+    }
+
+    impl ToolExecutor for MixedSpeed {
+        async fn execute(&self, call: &ToolCall) -> ToolResult {
+            self.started.fetch_add(1, Ordering::SeqCst);
+            let mut guard = CancelGuard {
+                canceled: self.canceled.clone(),
+                completed: false,
+            };
+            let delay = if call.name == "Fast" {
+                Duration::from_millis(10)
+            } else {
+                Duration::from_secs(5)
+            };
+            tokio::time::sleep(delay).await;
+            guard.completed = true;
+            ToolResult {
+                tool_call_id: call.id.clone(),
+                name: call.name.clone(),
+                output: "ok".into(),
+                failed: false,
+                duration_ms: delay.as_millis() as u64,
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn deadline_retains_completed_results_and_cancels_the_rest() {
+        let started_count = Arc::new(AtomicUsize::new(0));
+        let canceled = Arc::new(AtomicUsize::new(0));
+        let exec = MixedSpeed {
+            started: started_count.clone(),
+            canceled: canceled.clone(),
+        };
+        let calls = vec![
+            ToolCall {
+                id: "slow".into(),
+                name: "Slow".into(),
+                arguments: "{}".into(),
+            },
+            ToolCall {
+                id: "fast".into(),
+                name: "Fast".into(),
+                arguments: "{}".into(),
+            },
+            ToolCall {
+                id: "queued".into(),
+                name: "Queued".into(),
+                arguments: "{}".into(),
+            },
+            ToolCall {
+                id: "unstarted".into(),
+                name: "Unstarted".into(),
+                arguments: "{}".into(),
+            },
+        ];
+
+        let started = Instant::now();
+        let results = execute_tools(&calls, &exec, 2, Duration::from_millis(100)).await;
+
+        assert!(started.elapsed() < Duration::from_secs(1));
+        assert_eq!(results.len(), 4);
+        assert!(results[0].failed);
+        assert!(!results[1].failed);
+        assert_eq!(results[1].output, "ok");
+        assert!(results[2].failed);
+        assert!(results[3].failed);
+        assert_eq!(results[0].duration_ms, 100);
+        assert_eq!(results[2].duration_ms, 100);
+        assert_eq!(results[3].duration_ms, 100);
+        assert_eq!(started_count.load(Ordering::SeqCst), 3);
+        assert_eq!(canceled.load(Ordering::SeqCst), 2);
+    }
 }
