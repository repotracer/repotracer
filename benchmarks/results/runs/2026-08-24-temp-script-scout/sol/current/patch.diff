+    struct CancellationGuard(Arc<AtomicUsize>);
+
+    impl Drop for CancellationGuard {
+        fn drop(&mut self) {
+            self.0.fetch_sub(1, Ordering::SeqCst);
+        }
+    }
+
+    struct VariableSleep {
+        started: Arc<AtomicUsize>,
+        active: Arc<AtomicUsize>,
+    }
+
+    impl ToolExecutor for VariableSleep {
+        async fn execute(&self, call: &ToolCall) -> ToolResult {
+            self.started.fetch_add(1, Ordering::SeqCst);
+            self.active.fetch_add(1, Ordering::SeqCst);
+            let _guard = CancellationGuard(self.active.clone());
+            let sleep_ms: u64 = call.arguments.parse().unwrap();
+            tokio::time::sleep(Duration::from_millis(sleep_ms)).await;
+            ToolResult {
+                tool_call_id: call.id.clone(),
+                name: call.name.clone(),
+                output: "ok".into(),
+                failed: false,
+                duration_ms: sleep_ms,
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn deadline_retains_completed_results_and_cancels_the_rest() {
+        let started_count = Arc::new(AtomicUsize::new(0));
+        let active = Arc::new(AtomicUsize::new(0));
+        let exec = VariableSleep {
+            started: started_count.clone(),
+            active: active.clone(),
+        };
+        let calls: Vec<ToolCall> = [20, 500, 500, 20]
+            .into_iter()
+            .enumerate()
+            .map(|(i, sleep_ms)| ToolCall {
+                id: format!("c{i}"),
+                name: "Sleep".into(),
+                arguments: sleep_ms.to_string(),
+            })
+            .collect();
+
+        let started = Instant::now();
+        let results = execute_tools(&calls, &exec, 2, Duration::from_millis(100)).await;
+        let elapsed = started.elapsed();
+
+        assert!(elapsed < Duration::from_millis(300));
+        assert_eq!(results.len(), calls.len());
+        assert!(!results[0].failed);
+        assert_eq!(results[0].output, "ok");
+        assert!(results[1..].iter().all(|result| result.failed));
+        assert!(results[1..].iter().all(|result| result.duration_ms == 100));
+        assert!(results[1..]
+            .iter()
+            .all(|result| result.output.contains("timed out after 100ms")));
+        assert_eq!(started_count.load(Ordering::SeqCst), 3);
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+        for (i, result) in results.iter().enumerate() {
+            assert_eq!(result.tool_call_id, format!("c{i}"));
+        }
+    }
 }
