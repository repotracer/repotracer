+    #[cfg(unix)]
+    #[tokio::test]
+    async fn dropping_search_future_kills_ripgrep_child() {
+        use std::os::unix::fs::PermissionsExt;
+        use std::time::Duration;
+
+        let dir = tempdir().unwrap();
+        let fake_rg = dir.path().join("fake-rg");
+        let pid_file = dir.path().join("rg.pid");
+        fs::write(
+            &fake_rg,
+            "#!/bin/sh\nprintf '%s\\n' \"$$\" > rg.pid\nexec sleep 10\n",
+        )
+        .unwrap();
+        fs::set_permissions(&fake_rg, fs::Permissions::from_mode(0o755)).unwrap();
+        let tool = GrepTool {
+            root: dir.path().to_path_buf(),
+            rg_path: fake_rg,
+        };
+
+        let result = tokio::time::timeout(
+            Duration::from_millis(100),
+            tool.call(r#"{"pattern":"anything"}"#),
+        )
+        .await;
+        assert!(
+            result.is_err(),
+            "fake rg should still be running at timeout"
+        );
+
+        let pid = fs::read_to_string(pid_file).unwrap();
+        let pid = pid.trim();
+        let mut alive = true;
+        for _ in 0..20 {
+            alive = std::process::Command::new("kill")
+                .args(["-0", pid])
+                .stdout(Stdio::null())
+                .stderr(Stdio::null())
+                .status()
+                .is_ok_and(|status| status.success());
+            if !alive {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+        assert!(!alive, "cancelled ripgrep child {pid} is still running");
+    }
 }
