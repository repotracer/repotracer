+
+    struct CancelGuard(Arc<AtomicUsize>);
+
+    impl Drop for CancelGuard {
+        fn drop(&mut self) {
+            self.0.fetch_sub(1, Ordering::SeqCst);
+        }
+    }
+
+    struct OneFastOneBlocked {
+        active: Arc<AtomicUsize>,
+    }
+
+    impl ToolExecutor for OneFastOneBlocked {
+        async fn execute(&self, call: &ToolCall) -> ToolResult {
+            self.active.fetch_add(1, Ordering::SeqCst);
+            let _guard = CancelGuard(self.active.clone());
+            if call.id == "fast" {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+                ToolResult {
+                    tool_call_id: call.id.clone(),
+                    name: call.name.clone(),
+                    output: "completed".into(),
+                    failed: false,
+                    duration_ms: 10,
+                }
+            } else {
+                std::future::pending().await
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn deadline_retains_completed_results_and_cancels_siblings() {
+        let active = Arc::new(AtomicUsize::new(0));
+        let exec = OneFastOneBlocked {
+            active: active.clone(),
+        };
+        let calls = vec![
+            ToolCall {
+                id: "fast".into(),
+                name: "Grep".into(),
+                arguments: "{}".into(),
+            },
+            ToolCall {
+                id: "blocked".into(),
+                name: "Grep".into(),
+                arguments: "{}".into(),
+            },
+        ];
+
+        let started = Instant::now();
+        let results = execute_tools_until(
+            &calls,
+            &exec,
+            2,
+            Duration::from_secs(5),
+            tokio::time::Instant::now() + Duration::from_millis(75),
+        )
+        .await;
+
+        assert!(started.elapsed() < Duration::from_millis(500));
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+        assert_eq!(results.len(), 2);
+        assert_eq!(results[0].output, "completed");
+        assert!(!results[0].failed);
+        assert_eq!(results[0].duration_ms, 10);
+        assert!(results[1].failed);
+        assert!(results[1].output.contains("batch deadline expired"));
+        assert!(results[1].duration_ms >= 50);
+    }
+
+    struct ReadyAsDeadlineExpires {
+        active: Arc<AtomicUsize>,
+    }
+
+    impl ToolExecutor for ReadyAsDeadlineExpires {
+        async fn execute(&self, call: &ToolCall) -> ToolResult {
+            self.active.fetch_add(1, Ordering::SeqCst);
+            let _guard = CancelGuard(self.active.clone());
+            if call.id == "ready" {
+                let mut first_poll = true;
+                std::future::poll_fn(move |cx| {
+                    if first_poll {
+                        first_poll = false;
+                        std::thread::sleep(Duration::from_millis(20));
+                        cx.waker().wake_by_ref();
+                        std::task::Poll::Pending
+                    } else {
+                        std::task::Poll::Ready(())
+                    }
+                })
+                .await;
+                ToolResult {
+                    tool_call_id: call.id.clone(),
+                    name: call.name.clone(),
+                    output: "completed at deadline".into(),
+                    failed: false,
+                    duration_ms: 20,
+                }
+            } else {
+                std::future::pending().await
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn deadline_drains_results_that_become_ready_with_deadline() {
+        let active = Arc::new(AtomicUsize::new(0));
+        let exec = ReadyAsDeadlineExpires {
+            active: active.clone(),
+        };
+        let calls = vec![
+            ToolCall {
+                id: "ready".into(),
+                name: "Grep".into(),
+                arguments: "{}".into(),
+            },
+            ToolCall {
+                id: "blocked".into(),
+                name: "Grep".into(),
+                arguments: "{}".into(),
+            },
+        ];
+
+        let results = execute_tools_until(
+            &calls,
+            &exec,
