+        )
+        .await;
+
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+        assert_eq!(results[0].output, "completed at deadline");
+        assert!(!results[0].failed);
+        assert_eq!(results[0].duration_ms, 20);
+        assert!(results[1].failed);
+        assert!(results[1].output.contains("batch deadline expired"));
+        assert!(results[1].duration_ms > 0);
+    }
